# NEXORA Backend Server Environment Variables (.env.example)
# Copy this file to .env on your backend server. Never commit actual secrets.

PORT=8080
NODE_ENV=production
ALLOWED_ORIGINS=https://your-nexora-domain.example.com

# Rate Limiting & Job Cleanup
RATE_limit_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
JOB_EXPIRATION_SECONDS=3600
MAX_DOWNLOAD_BYTES=524288000

# FFmpeg Binary Path (defaults to system ffmpeg in PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional Authorized Provider API Credentials (Server-Side Only)
YOUTUBE_DATA_API_KEY=
INSTAGRAM_GRAPH_ACCESS_TOKEN=
